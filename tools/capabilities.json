{
  "probes": [
    { "id": "doctor", "label": "Check this machine", "args": ["doctor"] },
    { "id": "typecheck", "label": "Typecheck the project", "bin": "tsc", "args": ["-p", "tsconfig.json"] },
    { "id": "pack-fresh", "label": "Pack a web Release, before any check", "args": ["module", "pack", "src/index.ts"], "fresh": true },
    { "id": "check-fast", "label": "Fast module check", "args": ["module", "check", ".", "--fast"] },
    { "id": "check-full", "label": "Full module check", "args": ["module", "check", "."] },
    { "id": "check-tests", "label": "Module check with the project's tests", "args": ["module", "check", ".", "--fast", "--tests"] },
    { "id": "dev-check", "label": "Workbench starts and passes its light gates", "args": ["dev", ".", "--check", "--silent"], "until": "gates: (passed|failed)", "okText": "gates: passed", "timeoutSec": 90 },
    { "id": "verify-browser", "label": "Drive the workbench in Chrome", "args": ["module", "verify-browser", "src/index.ts"], "timeoutSec": 180 },
    { "id": "screenshot", "label": "Screenshot the built face", "args": ["module", "screenshot", "."], "timeoutSec": 180 },
    { "id": "pack-after-check", "label": "Pack a web Release, after a module check", "args": ["module", "pack", "src/index.ts"], "gap": "DEVX-065" },
    { "id": "eval-sanity", "label": "Offline render report for a Processor", "args": ["module", "eval", "src/index.ts"], "gap": "DEVX-070" },
    { "id": "eval-levels", "label": "Loudness suite with built-in test audio", "args": ["module", "eval", "--suite", "levels", "--no-presets", "--input-lufs", "-18", "--max-seconds", "2"], "gap": "DEVX-061" },
    { "id": "eval-levels-wav", "label": "Loudness suite with my own WAV", "args": ["module", "eval", "--suite", "levels", "--no-presets", "--input-lufs", "-18", "--max-seconds", "2", "--stimulus", "stimulus.wav"], "gap": "DEVX-061" },
    { "id": "preview", "label": "Render demo audio", "args": ["module", "preview", "src/index.ts"], "gap": "DEVX-061" },
    { "id": "publish-dry-run", "label": "Publication dry run", "args": ["publish", "--dry-run"], "timeoutSec": 180 },
    { "id": "status", "label": "Module status", "args": ["module", "status", "."] },
    { "id": "paths", "label": "Module paths", "args": ["module", "paths", "src/index.ts"] },
    { "id": "outputs", "label": "Module outputs and signing readiness", "args": ["module", "outputs", "."] },
    { "id": "version", "label": "Module version", "args": ["module", "version", "."] },
    { "id": "guides", "label": "List guides", "args": ["guide", "list"] },
    { "id": "guide-props", "label": "Read UI kit component props", "args": ["guide", "props", "Knob"] },
    { "id": "dsp-effects", "label": "List named effects", "args": ["dsp", "effects"] },
    { "id": "dsp-nodes", "label": "List DSP nodes", "args": ["dsp", "nodes"] },
    { "id": "catalog", "label": "List catalog modules", "args": ["module", "list"] },
    { "id": "community", "label": "Search community modules", "args": ["community", "search", "--query", "delay"] },
    { "id": "plugin-caps", "label": "Local plug-in capabilities", "args": ["plugin", "capabilities"] },
    { "id": "module-doctor", "label": "Module toolchain check", "args": ["module", "doctor"], "gap": "DEVX-062" },
    { "id": "setup-native", "label": "Install native build components", "args": ["setup", "native"], "gap": "DEVX-062" },
    { "id": "verify", "label": "Verify every declared format", "args": ["module", "verify", "src/index.ts"], "gap": "DEVX-063" },
    { "id": "plugin-build", "label": "Build a VST3", "args": ["plugin", "build", "src/index.ts", "--format", "vst3"], "gap": "DEVX-063", "timeoutSec": 300 },
    { "id": "portability", "label": "Check the Processor can compile to WebAssembly and native", "args": ["module", "check", ".", "--portability"], "gap": "DEVX-064" },
    { "id": "export", "label": "Export for the native shells", "args": ["module", "export", "src/index.ts"], "gap": "DEVX-064" },
    { "id": "pack-npm", "label": "Stage the module as an npm package", "args": ["module", "pack-npm", "src/index.ts"], "gap": "DEVX-064" },
    { "id": "plugin-test", "label": "Run the plug-in diagnostic matrix", "args": ["plugin", "test", "."], "gap": "DEVX-066" },
    { "id": "plugin-package", "label": "Write a plug-in submission package", "args": ["plugin", "package", "."], "gap": "DEVX-066" },
    { "id": "preset-list", "label": "List this project's presets", "args": ["preset", "list"], "gap": "DEVX-067" },
    { "id": "face-first-example", "label": "Run the face-first command as `maru module examples` prints it", "args": ["init", "face-first-trial", "--from", "blank-face-first"], "gap": "DEVX-068", "fresh": true }
  ],
  "absent": [
    { "id": "cpu", "label": "Measure a Processor's CPU use", "terms": "cpu|benchmark|profil", "searchIn": ["module check", "module eval", "module verify", "dev"], "gap": "DEVX-071" },
    { "id": "soak", "label": "Run a long soak or stress test", "terms": "soak|stress|long-run|denormal", "searchIn": ["module check", "module eval", "module verify", "dev"], "gap": "DEVX-071" },
    { "id": "compare", "label": "Compare against a reference recording or an earlier version's sound", "terms": "reference|a/b|null test", "searchIn": ["module eval", "module preview", "dev"], "gap": "DEVX-073" },
    { "id": "listening", "label": "Record a listening result beside the Release", "terms": "listening|audition note", "searchIn": ["module check", "module status", "dev"], "gap": "DEVX-073" },
    { "id": "a11y", "label": "Check the face's accessibility", "terms": "accessib|a11y|contrast", "searchIn": ["module check", "module screenshot", "module verify-browser"], "gap": "DEVX-074" },
    { "id": "locale", "label": "Translate face text", "terms": "locale|i18n|translat", "searchIn": ["module check", "module pack", "guide"], "gap": "DEVX-074" },
    { "id": "signal-audit", "label": "Run the signal-audit gate by flag", "terms": "signal-audit|signal audit", "searchIn": ["module check"], "gap": "DEVX-068" },
    { "id": "unpublish-module", "label": "Unpublish a module from the command line", "terms": "^Usage: .*\\bmodule\\b.*unpublish", "searchIn": ["unpublish"], "gap": "DEVX-068" }
  ]
}
